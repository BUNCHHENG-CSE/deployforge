# ====================================================================
# DeployForge Environment Configuration
# ====================================================================

# Environment mode: 'development' or 'production'
ENVIRONMENT=development
DEBUG=true

# PostgreSQL Production & Local WSL Docker Connection
POSTGRES_USER=deployforge
POSTGRES_PASSWORD=deployforge_secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=deployforge

# Explicit Database URL (Optional - dynamically computed from above if omitted)
# DATABASE_URL=postgresql+psycopg://deployforge:deployforge_secret@127.0.0.1:5433/deployforge

# Production Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Security
SECRET_KEY=deployforge-super-secret-key-change-in-production
