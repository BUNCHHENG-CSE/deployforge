# TCT DeployForge Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database Engine: 'sqlite' (zero-dependency local development) or 'postgresql' (Neon & Production)
DB_TYPE=sqlite

# Local SQLite Database URL (Prisma file: syntax)
DATABASE_URL="file:./deployforge.db"

# Neon / PostgreSQL Connection for Production:
# DATABASE_URL="postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret Key
SECRET_KEY=deployforge-super-secret-key-change-in-production
